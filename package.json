{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "media:backfill": "node scripts/backfill-church-media.mjs",
    "test:pastor-history": "node --test tests/pastor-history-pipeline.test.mjs",
    "pastor-history:roster": "node scripts/build-pastor-history-roster.mjs",
    "pastor-history:collect": "node scripts/collect-pastor-history.mjs",
    "pastor-history:import:dry-run": "node scripts/dry-run-pastor-history-import.mjs",
    "worship:collect": "node scripts/worship-schedules/collect.mjs --input data/worship-schedules/pilot-churches.json --policy data/worship-schedules/policies.json --output data/worship-schedules/pilot-output.json",
    "worship:validate": "node scripts/worship-schedules/validate.mjs --input data/worship-schedules/pilot-output.json --output data/worship-schedules/validated-dry-run.json",
    "worship:plan": "node scripts/worship-schedules/import-plan.mjs --input data/worship-schedules/validated-dry-run.json --output data/worship-schedules/import-plan.json",
    "worship:export-all": "node scripts/worship-schedules/export-registered-churches.mjs",
    "worship:collect-all": "node scripts/worship-schedules/collect-all.mjs",
    "worship:validate-all": "node scripts/worship-schedules/validate.mjs --input data/worship-schedules/all-output.json --output data/worship-schedules/all-validated-dry-run.json",
    "worship:plan-all": "node scripts/worship-schedules/import-plan.mjs --input data/worship-schedules/all-validated-dry-run.json --output data/worship-schedules/all-import-plan.json",
    "worship:report-all": "node scripts/worship-schedules/report.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
