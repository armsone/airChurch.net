{
  "version": 1,
  "policyId": "approved-church-all-official-pastors-v4",
  "basis": "airChurch에서 검토 승인된 교회",
  "phase": "all_official_church_pastors",
  "roleCategories": {
    "current_primary": ["담임목사", "위임목사", "대표목사"],
    "associate": ["부목사", "수석부목사", "행정목사", "목양목사"],
    "education": ["교육목사", "강도사", "전임전도사", "교육전도사", "전도사"],
    "cooperating": ["협동목사"],
    "founding": ["설립목사", "창립목사", "개척목사", "초대목사", "초대담임목사"],
    "emeritus": ["원로목사"],
    "retired": ["은퇴목사"]
  },
  "allowedRegionPrefixes": ["서울", "부산", "대구", "인천", "광주", "대전", "울산", "세종", "경기", "강원", "충북", "충남", "전북", "전남", "경북", "경남", "제주"],
  "excludedAppearances": ["초청 설교자", "행사 강사", "집회 인도자", "개인 SNS에서만 소속을 주장한 사람"],
  "requiredIdentityAxes": ["pastor", "church", "denomination", "region", "role"],
  "minimumOfficialIdentitySources": 1,
  "allowsPublicHttpRead": true,
  "visibilityPriorityPolicy": "equal_across_role_categories",
  "photoPolicy": {
    "publicRoleBasis": "교회와 교단의 공식 공개 페이지에서 목회 직분을 수행하는 인물로 식별되는 단독 프로필",
    "publicationMode": "publish_then_notice_and_takedown",
    "individualPreApprovalRequired": false,
    "allowedSources": ["교회 공식 홈페이지", "교단 공식 홈페이지"],
    "excludedSources": ["개인 SNS", "사적 블로그", "제3자 언론·인물정보 사이트"],
    "excludedSubjects": ["가족", "친인척", "일반 신도", "직무와 무관한 제3자"],
    "requiredEvidence": ["목회자 이름", "목회 직분", "공식 출처 URL", "확인일", "단독 프로필 형태"],
    "takedownPolicy": "구체적인 문제 제기 접수 시 즉시 임시 비노출 후 사실·인물·권리 관계를 확인하여 복구·교체·삭제"
  },
  "publicationDefault": false
}
